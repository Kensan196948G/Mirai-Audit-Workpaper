{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mirai-audit-workpaper",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirai-audit-workpaper-db",
      "database_id": "9dc07915-8e25-4d21-97fb-405054f08136",
      "migrations_dir": "migrations"
    }
  ]
}
