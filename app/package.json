{
  "name": "mirai-audit-workpaper",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "監査業務・証跡管理（Cloudflare Workers + D1 + ネイティブHTML/JS SPA）— 要件定義書 MAW-RD-001 の実装",
  "scripts": {
    "dev": "concurrently -k -n web,server -c blue,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite build --watch -c web/vite.config.ts",
    "dev:server": "wrangler dev -c wrangler.jsonc",
    "build": "npm run build:web && npm run build:embedded && npm run typecheck",
    "build:web": "vite build -c web/vite.config.ts",
    "build:embedded": "node scripts/build-embedded.mjs",
    "build:worker": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint src web/src --max-warnings 0",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply mirai-audit-workpaper-mvp-db --local -c wrangler.jsonc",
    "db:seed:local": "node scripts/seed.mjs --local",
    "types": "wrangler types",
    "deploy:preview": "npm run build && wrangler deploy -c wrangler.jsonc",
    "deploy:production": "npm run build && wrangler deploy -c wrangler.production.jsonc"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.0",
    "wrangler": "^4.121.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
